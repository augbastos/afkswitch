    {
      "name": "all-peers-notified",
      "kind": "notify",
      "expect": "pass",
      "description": "Two live local peers are told; the stale Remote Control row sharing a name, the subagent and the cloud row are not touched. The live 'api' shares its name with the offline row, so it is addressed with its ref.",
      "transcript": {
        "self": "main",
        "state": {
          "ok": true,
          "generation": 5,
          "reset": false
        },
        "listing": [
          {
            "name": "main",
            "ref": "m0",
            "kind": "interactive",
            "state": "busy",
            "location": "local",
            "self": true
          },
          {
            "name": "api",
            "ref": "a1",
            "kind": "interactive",
            "state": "idle",
            "location": "local"
          },
          {
            "name": "docs",
            "ref": "d1",
            "kind": "interactive",
            "state": "busy",
            "location": "local"
          },
          {
            "name": "api",
            "ref": "a9",
            "kind": "interactive",
            "state": "offline",
            "location": "remote-control"
          },
          {
            "name": "helper",
            "ref": "h1",
            "kind": "subagent",
            "state": "idle",
            "location": "local"
          },
          {
            "name": "cloudy",
            "ref": "c1",
            "kind": "interactive",
            "state": "idle",
            "location": "cloud"
          }
        ],
        "sends": [
          {
            "to": "api [a1]",
            "generation": 5,
            "reset": false,
            "attempt": 1,
            "result": "delivered"
          },
          {
            "to": "docs",
            "generation": 5,
            "reset": false,
            "attempt": 1,
            "result": "delivered"
          }
        ],
        "report": {
          "generation": 5,
          "discovered": 2,
          "notified": [
            "api [a1]",
            "docs"
          ],
          "not_notified": []
        }
      }
    },
